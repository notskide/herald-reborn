# Copy these into Wispbyte's Startup / Environment Variables panel.
# Never commit real secrets to GitHub.

# Required for protected API routes. Generate a long random key for private testing.
HERALD_API_KEY=replace_with_a_long_random_private_key

# OpenAI-compatible backend base URL, including the version path when applicable.
# Example shape only: https://provider.example/v1
HERALD_UPSTREAM_BASE_URL=
HERALD_UPSTREAM_API_KEY=

# Map public Herald model names to real model IDs available from your backend.
# These are examples/placeholders, not claims that Herald's own weights exist yet.
HERALD_CORE_UPSTREAM_MODEL=
HERALD_SENTINEL_UPSTREAM_MODEL=

# Optional request timeout, in seconds (between 1 and 300).
HERALD_UPSTREAM_TIMEOUT_SECONDS=60
